
{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.resboard.online/api/$1"
    },
    {
      "source": "/accounts/(.*)",
      "destination": "https://api.resboard.online/accounts/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://api.resboard.online/media/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
